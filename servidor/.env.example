# Copia este archivo como servidor/.env y completa los valores.
# El .env nunca se sirve al navegador ni se sube al repositorio.

# API de facturación
API_URL=https://sunat.kodevo.es/api/v1
API_KEY=
API_SECRET=

# PIN que cada equipo ingresa una vez (Configuración → Credenciales API).
# Obligatorio si el servidor es accesible desde la red o internet.
PIN_ACCESO=

# Servidor
PUERTO=8080
HOST=0.0.0.0

# Respaldos automáticos de data.json (una copia por equipo y hora)
CARPETA_RESPALDOS=respaldos
DIAS_RESPALDO=30
